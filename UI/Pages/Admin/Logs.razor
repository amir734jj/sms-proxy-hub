@page "/admin/logs"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration
@using Shared.Contracts
@inject AuthService Auth
@inject NavigationManager Nav
@inject IConfiguration Config
@implements IAsyncDisposable

<PageTitle>Live Logs - SMS Proxy Hub</PageTitle>

@if (!Auth.IsAuthenticated || !Auth.IsAdmin) { Nav.NavigateTo("/"); return; }

<div class="d-flex align-items-center mb-3 gap-2">
    <h4 class="mb-0 me-2">Live Logs</h4>
    <span class="badge @(_connected ? "bg-success" : "bg-secondary")">@(_connected ? "Connected" : "Disconnected")</span>
    <HxButton Text="Clear" Color="ThemeColor.Secondary" Size="ButtonSize.Small" CssClass="ms-auto" OnClick="() => _lines.Clear()" />
</div>

@if (_error is not null) { <HxAlert Color="ThemeColor.Danger" CssClass="mb-3">@_error</HxAlert> }

<pre class="bg-dark text-light p-3 rounded" style="height:75vh; overflow:auto; white-space:pre-wrap;">@string.Join("\n", _lines)</pre>

@code {
    readonly List<string> _lines = [];
    const int MaxLines = 1000;
    HubConnection? _hub;
    bool _connected;
    string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || !Auth.IsAdmin) return;

        var baseUrl = Config["ApiBaseUrl"];
        if (string.IsNullOrWhiteSpace(baseUrl)) baseUrl = Nav.BaseUri;
        var hubUrl = $"{baseUrl.TrimEnd('/')}/hubs/logs";

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl, options => options.AccessTokenProvider = () => Task.FromResult(Auth.Token))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<LogStreamEntry>("Log", OnLog);
        _hub.Reconnected += _ => { _connected = true; return InvokeAsync(StateHasChanged); };
        _hub.Reconnecting += _ => { _connected = false; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _connected = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to connect: {ex.Message}";
        }
    }

    void OnLog(LogStreamEntry entry)
    {
        var line = $"{entry.Timestamp.ToLocalTime():HH:mm:ss} [{entry.Source}] {entry.Level} {entry.Message}";
        if (!string.IsNullOrEmpty(entry.Detail)) line += $"\n    {entry.Detail}";

        // Most recent on top; keep appending newer lines above older ones.
        _lines.Insert(0, line);
        if (_lines.Count > MaxLines) _lines.RemoveRange(MaxLines, _lines.Count - MaxLines);
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
