@page "/connections"
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IHxMessageBoxService MessageBox
@using Shared

<PageTitle>Connections - SMS Proxy Hub</PageTitle>

@if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }

<div class="d-flex align-items-center mb-4">
    <h4 class="mb-0">SMS Connections</h4>
    <div class="ms-auto">
        <HxButton Text="Refresh" Color="ThemeColor.Secondary" Size="ButtonSize.Small" OnClick="LoadAsync" />
    </div>
</div>

@if (_error is not null) { <HxAlert Color="ThemeColor.Danger" CssClass="mb-3">@_error</HxAlert> }
@if (_success is not null) { <HxAlert Color="ThemeColor.Success" CssClass="mb-3">@_success</HxAlert> }

<HxCard CssClass="mb-4">
    <HeaderTemplate><strong>Add Connection</strong></HeaderTemplate>
    <BodyTemplate>
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" @bind="_newName" placeholder="My SmsGate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Provider</label>
                <select class="form-select" @bind="_newProvider">
                    <option value="@SmsProviderType.SmsGate">SmsGate</option>
                    <option value="@SmsProviderType.Twilio">Twilio</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Retention (days)</label>
                <input type="number" class="form-control" min="1" max="3650" @bind="_newMessageRetentionDays" />
                <small class="text-muted d-block mt-1">Used for webhook delivery history and reply-matching records.</small>
            </div>
            @if (_newProvider == SmsProviderType.SmsGate)
            {
                <SmsGateConfigForm @ref="_smsGateForm" OnError="e => { _error = e; StateHasChanged(); }" />
            }
            else
            {
                <TwilioConfigForm @ref="_twilioForm" />
            }
            <div class="col-md-1 d-flex align-items-end">
                <HxButton Text="Create" Color="ThemeColor.Primary" OnClick="CreateAsync" CssClass="w-100" />
            </div>
        </div>
    </BodyTemplate>
</HxCard>

@if (_connections.Count == 0 && !_loading)
{
    <p class="text-muted">No connections. Create one above.</p>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var c in _connections)
        {
            <HxCard>
                <BodyTemplate>
                    <div class="d-flex align-items-center">
                        <div class="d-flex flex-column me-2">
                            <button class="btn btn-sm btn-outline-secondary py-0 mb-1" @onclick="@(() => MoveAsync(c, -1))"
                                    disabled="@(_connections.IndexOf(c) == 0)" title="Move up (higher priority)">&#9650;</button>
                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="@(() => MoveAsync(c, 1))"
                                    disabled="@(_connections.IndexOf(c) == _connections.Count - 1)" title="Move down (lower priority)">&#9660;</button>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@c.Name</div>
                            <div class="d-flex gap-2 mt-1 flex-wrap align-items-center">
                                <span class="badge bg-info">@c.ProviderType</span>
                                <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span>
                                <span class="badge bg-dark" title="Failover priority (lower = tried first)">Priority: @c.Priority</span>
                                <span class="badge bg-secondary" title="Messages and webhook deliveries are cleaned after this many days">Retention: @c.MessageRetentionDays days</span>
                                @if (_deviceStatus.TryGetValue(c.Id, out var ds) && ds is not null)
                                {
                                    <span class="badge @(ds.Online ? "bg-success" : "bg-secondary")"
                                          title="@(ds.LastSeenAt is null ? "" : $"Last seen {ds.LastSeenAt.Value.ToLocalTime():g}")">
                                        Device @(ds.Online ? "Online" : "Offline")
                                    </span>
                                    @if (ds.BatteryLevel is not null)
                                    {
                                        <span class="badge bg-secondary">Battery @ds.BatteryLevel%@(ds.IsCharging == true ? " (charging)" : "")</span>
                                    }
                                    @if (ds.HasInternet is not null)
                                    {
                                        <span class="badge @(ds.HasInternet == true ? "bg-success" : "bg-warning text-dark")">
                                            Internet @(ds.HasInternet == true ? "Connected" : "Down")
                                        </span>
                                    }
                                    @if (ds.ConnectionTransport is not null)
                                    {
                                        <span class="badge bg-secondary" title="Raw transport flags: @ds.ConnectionTransport">
                                            Transport @TransportLabel(ds.ConnectionTransport.Value) (@ds.ConnectionTransport)
                                        </span>
                                    }
                                    @if (ds.CellularNetworkType is not null)
                                    {
                                        <span class="badge bg-secondary" title="Raw cellular network index: @ds.CellularNetworkType">
                                            Cellular @CellularTypeLabel(ds.CellularNetworkType.Value) (@ds.CellularNetworkType)
                                        </span>
                                    }
                                    @if (ds.FailedMessagesLastHour is not null)
                                    {
                                        <span class="badge @(ds.FailedMessagesLastHour == 0 ? "bg-success" : "bg-warning text-dark")">
                                            Failed(last hour): @ds.FailedMessagesLastHour
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ds.HealthStatus))
                                    {
                                        <span class="badge bg-dark">Health @ds.HealthStatus</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ds.Version))
                                    {
                                        <span class="badge bg-secondary">App v@(ds.Version)</span>
                                    }
                                }
                            </div>
                            <div class="mt-1">
                                <small class="text-muted" title="Auto-registered with the provider on connection create">Webhook: <code>/api/provider-webhook/@c.Id</code></small>
                            </div>
                            @if (c.ProviderType == SmsProviderType.SmsGate && !string.IsNullOrWhiteSpace(c.BaseUrl))
                            {
                                <div class="mt-1 text-break">
                                    <small class="text-muted">Base URL: <code>@c.BaseUrl</code></small>
                                </div>
                            }
                            <div class="mt-2 d-flex gap-2 align-items-center flex-wrap">
                                <label class="small text-muted mb-0" for="@($"retention-{c.Id}")">Retention days</label>
                                <input id="@($"retention-{c.Id}")" type="number" class="form-control form-control-sm" style="width: 100px;"
                                       min="1" max="3650"
                                       value="@GetRetentionInputValue(c.Id, c.MessageRetentionDays)"
                                       @onchange="e => OnRetentionInputChanged(c.Id, e.Value?.ToString())" />
                                <HxButton Text="Save retention" Color="ThemeColor.Secondary" Size="ButtonSize.Small"
                                          OnClick="@(() => SaveRetentionAsync(c))" />
                            </div>
                        </div>
                        <HxButton Text="Show webhooks" Color="ThemeColor.Secondary" Size="ButtonSize.Small" CssClass="me-2 text-nowrap flex-shrink-0"
                                  OnClick="@(() => ShowWebhooksAsync(c))" />
                        <HxButton Text="Re-register webhook" Color="ThemeColor.Secondary" Size="ButtonSize.Small" CssClass="me-2 text-nowrap flex-shrink-0"
                                  OnClick="@(() => RevalidateWebhookAsync(c))" />
                        <HxButton Text="Delete" Color="ThemeColor.Danger" Size="ButtonSize.Small" CssClass="text-nowrap flex-shrink-0"
                                  OnClick="@(() => DeleteAsync(c))" />
                    </div>
                    @if (_webhookInfo.TryGetValue(c.Id, out var info))
                    {
                        <div class="alert @(info.Success ? "alert-success" : "alert-danger") py-2 px-3 mt-2 mb-0 small text-break">
                            <div>@info.Message</div>
                            @if (info.RegisteredWebhooks.Count > 0)
                            {
                                <ul class="mb-0 mt-1">
                                    @foreach (var wh in info.RegisteredWebhooks)
                                    {
                                        <li><code>@wh.Event</code> &rarr; <code>@wh.Url</code></li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    @if (_registeredWebhooks.TryGetValue(c.Id, out var hooks))
                    {
                        <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-break">
                            @if (hooks.Count == 0)
                            {
                                <div>No webhooks registered on the device for this connection.</div>
                            }
                            else
                            {
                                <div class="fw-semibold mb-1">Registered webhooks (@hooks.Count):</div>
                                <ul class="mb-0">
                                    @foreach (var wh in hooks)
                                    {
                                        <li><code>@wh.Event</code> &rarr; <code>@wh.Url</code> <span class="text-muted">(@wh.Id)</span></li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    @if (_deviceStatus.TryGetValue(c.Id, out var statusDetails) && statusDetails?.Checks?.Count > 0)
                    {
                        <details class="mt-2">
                            <summary class="small">Device health checks (@statusDetails.Checks.Count)</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Check</th>
                                            <th>Value</th>
                                            <th>Unit</th>
                                            <th>Status</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var check in statusDetails.Checks)
                                        {
                                            <tr>
                                                <td><code>@check.Key</code></td>
                                                <td>@(check.ObservedValue?.ToString() ?? "-")</td>
                                                <td>@(check.ObservedUnit ?? "-")</td>
                                                <td>@(check.Status ?? "-")</td>
                                                <td>@(check.Description ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </BodyTemplate>
            </HxCard>
        }
    </div>
}

@code {
    List<SmsConnectionDto> _connections = [];
    bool _loading;
    string? _error, _success;
    string _newName = "";
    SmsProviderType _newProvider = SmsProviderType.SmsGate;
    int _newMessageRetentionDays = MessageRetention.Days;
    SmsGateConfigForm? _smsGateForm;
    TwilioConfigForm? _twilioForm;
    readonly Dictionary<Guid, WebhookRevalidationResult> _webhookInfo = [];
    readonly Dictionary<Guid, List<RegisteredWebhookDto>> _registeredWebhooks = [];
    readonly Dictionary<Guid, DeviceStatusDto?> _deviceStatus = [];
    readonly Dictionary<Guid, int> _editedRetentionDays = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { _connections = await Api.GetConnectionsAsync(); }
        catch (Exception ex) { _error = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }

        foreach (var c in _connections)
        {
            _editedRetentionDays[c.Id] = c.MessageRetentionDays;
            try { _deviceStatus[c.Id] = await Api.GetDeviceStatusAsync(c.Id); }
            catch { /* status is best-effort */ }
        }
    }

    async Task CreateAsync()
    {
        _error = null; _success = null;
        if (string.IsNullOrWhiteSpace(_newName)) { _error = "Name is required."; return; }
        if (_newMessageRetentionDays < 1 || _newMessageRetentionDays > 3650)
        {
            _error = "Retention days must be between 1 and 3650.";
            return;
        }

        SmsConnectionConfig config = _newProvider switch
        {
            SmsProviderType.SmsGate => _smsGateForm!.GetConfig(),
            SmsProviderType.Twilio => _twilioForm!.GetConfig(),
            _ => throw new InvalidOperationException()
        };

        try
        {
            await Api.CreateConnectionAsync(new CreateConnectionRequest(_newName.Trim(), config, _newMessageRetentionDays));
            _newName = "";
            _newMessageRetentionDays = MessageRetention.Days;
            _smsGateForm?.Reset();
            _twilioForm?.Reset();
            _success = "Connection created.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = $"Failed: {ex.Message}"; }
    }

    async Task DeleteAsync(SmsConnectionDto c)
    {
        if (!await MessageBox.ConfirmAsync("Delete Connection", $"Delete '{c.Name}'?")) return;
        try { await Api.DeleteConnectionAsync(c.Id); _success = "Deleted."; await LoadAsync(); }
        catch (Exception ex) { _error = $"Failed: {ex.Message}"; }
    }

    async Task RevalidateWebhookAsync(SmsConnectionDto c)
    {
        _error = null; _success = null;
        try
        {
            _webhookInfo[c.Id] = await Api.RevalidateWebhookAsync(c.Id);
        }
        catch (Exception ex) { _error = $"Re-register failed: {ex.Message}"; }
    }

    async Task ShowWebhooksAsync(SmsConnectionDto c)
    {
        _error = null; _success = null;
        try
        {
            _registeredWebhooks[c.Id] = await Api.GetRegisteredWebhooksAsync(c.Id);
        }
        catch (Exception ex) { _error = $"Failed to load webhooks: {ex.Message}"; }
    }

    async Task MoveAsync(SmsConnectionDto c, int direction)
    {
        var idx = _connections.IndexOf(c);
        var newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= _connections.Count) return;

        (_connections[idx], _connections[newIdx]) = (_connections[newIdx], _connections[idx]);

        try
        {
            await Api.ReorderConnectionsAsync(_connections.Select(x => x.Id).ToList());
            await LoadAsync();
        }
        catch (Exception ex) { _error = $"Reorder failed: {ex.Message}"; }
    }

    async Task SaveRetentionAsync(SmsConnectionDto c)
    {
        _error = null; _success = null;
        var days = GetRetentionInputValue(c.Id, c.MessageRetentionDays);
        if (days < 1 || days > 3650)
        {
            _error = "Retention days must be between 1 and 3650.";
            return;
        }

        try
        {
            await Api.UpdateRetentionDaysAsync(c.Id, days);
            _success = $"Updated retention for '{c.Name}' to {days} days.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to update retention: {ex.Message}";
        }
    }

    int GetRetentionInputValue(Guid connectionId, int fallback)
    {
        return _editedRetentionDays.TryGetValue(connectionId, out var days) ? days : fallback;
    }

    void OnRetentionInputChanged(Guid connectionId, string? raw)
    {
        if (!int.TryParse(raw, out var days))
        {
            return;
        }

        _editedRetentionDays[connectionId] = days;
    }

    static string TransportLabel(int flags)
    {
        if (flags <= 0) return "Unknown";

        var names = new List<string>();
        if ((flags & 1) != 0) names.Add("Cellular");
        if ((flags & 2) != 0) names.Add("Wi-Fi");
        if ((flags & 4) != 0) names.Add("Bluetooth");
        if ((flags & 8) != 0) names.Add("Ethernet");
        if ((flags & 16) != 0) names.Add("VPN");
        if ((flags & 32) != 0) names.Add("Wi-Fi Aware");
        if ((flags & 64) != 0) names.Add("LoWPAN");
        if ((flags & 128) != 0) names.Add("Test");
        if ((flags & 256) != 0) names.Add("USB");

        return names.Count == 0 ? "Unknown" : string.Join("+", names);
    }

    static string CellularTypeLabel(int networkType)
    {
        return networkType switch
        {
            0 => "Unknown",
            1 => "GPRS (2G)",
            2 => "EDGE (2G)",
            3 => "UMTS (3G)",
            4 => "CDMA",
            5 => "EVDO rev.0",
            6 => "EVDO rev.A",
            7 => "1xRTT",
            8 => "HSDPA",
            9 => "HSUPA",
            10 => "HSPA",
            11 => "iDEN",
            12 => "EVDO rev.B",
            13 => "LTE (4G)",
            14 => "eHRPD",
            15 => "HSPA+",
            16 => "GSM",
            17 => "TD-SCDMA",
            18 => "IWLAN",
            19 => "LTE-CA",
            20 => "NR (5G)",
            _ => "Other"
        };
    }
}
