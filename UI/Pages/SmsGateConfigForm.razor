@inject ApiService Api

<div class="col-md-2">
    <label class="form-label">Base URL</label>
    <input type="text" class="form-control" @bind="Config.BaseUrl" placeholder="https://..." />
</div>
<div class="col-md-2">
    <label class="form-label">Username</label>
    <input type="text" class="form-control" @bind="Config.Username" />
</div>
<div class="col-md-2">
    <label class="form-label">Password</label>
    <input type="password" class="form-control" @bind="Config.Password" />
</div>
<div class="col-md-3">
    <label class="form-label">Device ID</label>
    <div class="input-group">
        <input type="text" class="form-control" @bind="Config.DeviceId" list="@_deviceListId" placeholder="Select or enter a device ID" />
        <datalist id="@_deviceListId">
            @foreach (var d in _devices)
            {
                <option value="@d.Id">@d.Name (@d.Id)</option>
            }
        </datalist>
        <button class="btn btn-outline-secondary" type="button" @onclick="FetchDevicesAsync"
                disabled="@_fetchingDevices" title="Fetch devices from SMS Gate server">
            @if (_fetchingDevices) { <span class="spinner-border spinner-border-sm"></span> } else { <span>⟳</span> }
        </button>
    </div>
</div>

@code {
    [Parameter] public SmsGateConnectionConfig Config { get; set; } = new();
    [Parameter] public EventCallback<string?> OnError { get; set; }

    List<SmsGateDeviceDto> _devices = [];
    readonly string _deviceListId = $"devices-{Guid.NewGuid():N}";
    bool _fetchingDevices;

    public SmsGateConnectionConfig GetConfig() => Config;

    public void Reset()
    {
        Config = new();
        _devices = [];
        StateHasChanged();
    }

    async Task FetchDevicesAsync()
    {
        if (string.IsNullOrWhiteSpace(Config.BaseUrl) || string.IsNullOrWhiteSpace(Config.Username) || string.IsNullOrWhiteSpace(Config.Password))
        {
            await OnError.InvokeAsync("Fill in Base URL, Username and Password first.");
            return;
        }

        _fetchingDevices = true;
        try
        {
            _devices = await Api.GetSmsGateDevicesAsync(new SmsGateConnectionConfig
            {
                BaseUrl = Config.BaseUrl,
                Username = Config.Username,
                Password = Config.Password
            });
            if (_devices.Count == 0)
                await OnError.InvokeAsync("No devices found. Make sure credentials are correct and at least one device is registered.");
        }
        catch (Exception ex) { await OnError.InvokeAsync($"Failed to fetch devices: {ex.Message}"); }
        finally { _fetchingDevices = false; }
    }
}
