<div class="col-md-2">
    <label class="form-label">Account SID</label>
    <input type="text" class="form-control" @bind="Config.AccountSid" />
</div>
<div class="col-md-2">
    <label class="form-label">Auth Token</label>
    <input type="password" class="form-control" @bind="Config.AuthToken" />
</div>
<div class="col-md-2">
    <label class="form-label">From Number</label>
    <input type="text" class="form-control" @bind="Config.FromNumber" placeholder="+1..." />
</div>

@code {
    [Parameter] public TwilioConnectionConfig Config { get; set; } = new();

    public TwilioConnectionConfig GetConfig() => Config;

    public void Reset()
    {
        Config = new();
        StateHasChanged();
    }
}
